---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/posts.json';
import FollowUpdates from '../../components/FollowUpdates.astro';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const index = posts.findIndex((p) => p.slug === post.slug);
const newer = index > 0 ? posts[index - 1] : null;
const older = index < posts.length - 1 ? posts[index + 1] : null;

const bodies = import.meta.glob('../../content/articles/*.html', { query: '?raw', import: 'default', eager: true });
const body = bodies[`../../content/articles/${post.slug}.html`];
if (!body) throw new Error(`Missing article body for ${post.slug}`);
---
<BaseLayout title={`${post.title} — Jeremy McKellar`} description={post.excerpt}>
<div style="background:var(--canvas);min-height:100vh;">

  <header class="site-nav">
    <nav aria-label="Main">
      <a href="/" aria-label="Jeremy McKellar — home" class="wordmark">JM<span>.</span></a>
      <div style="display:flex;align-items:center;gap:28px;">
        <a href="/thoughts/" style="font-size:15px;font-weight:500;">All thoughts</a>
        <a href="/#connect" class="btn-gold">Let’s connect</a>
      </div>
    </nav>
  </header>

  <main id="main-content" style="max-width:860px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(20px,5vw,48px) 40px;">
    <a href="/thoughts/" style="font-family:var(--mono);font-size:13px;letter-spacing:0.16em;color:var(--slate);">&larr; ALL THOUGHTS</a>
    <p style="margin:36px 0 16px;font-family:var(--mono);font-size:13px;letter-spacing:0.16em;color:#E8B44C;">{post.date} · {post.category}</p>
    <h1 style="margin:0 0 20px;font-family:var(--display);font-weight:600;font-size:clamp(34px,5.5vw,64px);letter-spacing:-0.025em;line-height:1.06;">{post.title}</h1>
    <p style="margin:0 0 40px;font-size:16px;color:var(--slate);">Written by Jeremy McKellar</p>

    <div aria-hidden="true" style="width:100%;height:clamp(200px,30vw,340px);border-radius:20px;overflow:hidden;border:1px solid rgba(245,242,234,0.12);margin-bottom:56px;">
      <abstract-header seed={post.slug} variant="hero" style="display:block;width:100%;height:100%;"></abstract-header>
    </div>

    <article set:html={body} />

    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px;margin-top:64px;border-top:1px solid var(--hairline);padding-top:32px;">
      {newer && (
        <a href={`/thoughts/${newer.slug}/`} style="display:flex;flex-direction:column;gap:6px;max-width:340px;">
          <span style="font-family:var(--mono);font-size:12px;letter-spacing:0.14em;color:var(--slate);">&larr; NEWER</span>
          <span style="font-family:var(--display);font-weight:600;font-size:19px;line-height:1.2;">{newer.title}</span>
        </a>
      )}
      {older && (
        <a href={`/thoughts/${older.slug}/`} style="display:flex;flex-direction:column;gap:6px;max-width:340px;text-align:right;margin-left:auto;">
          <span style="font-family:var(--mono);font-size:12px;letter-spacing:0.14em;color:var(--slate);">OLDER &rarr;</span>
          <span style="font-family:var(--display);font-weight:600;font-size:19px;line-height:1.2;">{older.title}</span>
        </a>
      )}
    </div>

    <div style="margin-top:64px;"><FollowUpdates /></div>
  </main>

  <footer class="site-footer" style="margin-top:56px;">
    <span>&copy; 2026 Jeremy McKellar · Charlotte, NC</span>
    <div style="display:flex;gap:28px;">
      <a href="mailto:info@jeremymckellar.com">Email</a>
      <a href="https://www.linkedin.com/in/jeremy-mckellar/" target="_blank" rel="noopener">LinkedIn &nearr;</a>
      <a href="/thoughts/">All thoughts &rarr;</a>
    </div>
  </footer>
</div>
<script src="/scripts/abstract-header.js" is:inline defer></script>
</BaseLayout>

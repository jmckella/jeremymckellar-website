---
import BaseLayout from '../layouts/BaseLayout.astro';
import posts from '../data/posts.json';
import FollowUpdates from '../components/FollowUpdates.astro';

const latest = posts.slice(0, 3);
const workbenchPhrases = [
  'practical AI and everyday workflows',
  'useful tools, built with curiosity',
  'technology that brings people together',
];
---
<BaseLayout
  title="Jeremy McKellar — Technologist & Storyteller"
  description="Jeremy McKellar connects technology, people, and ideas through practical AI, Microsoft 365, creative prototypes, and storytelling. Based in Charlotte, NC."
>
<div id="top" data-scroll-story style="background:var(--canvas);min-height:100vh;overflow-x:clip;position:relative;">

  <!-- NAV -->
  <header class="site-nav">
    <nav aria-label="Main">
      <a href="#top" aria-label="Jeremy McKellar — home" class="wordmark">JM<span>.</span></a>
      <div class="nav-links" style="display:flex;align-items:center;gap:36px;font-size:15px;font-weight:500;">
        <a href="#experiments">Selected work</a>
        <a href="#thoughts">Thoughts</a>
        <a href="#approach">Start here</a>
        <a href="#about">About</a>
      </div>
      <div style="display:flex;align-items:center;gap:16px;">
        <a data-magnetic href="#connect" class="btn-gold">Let’s connect</a>
        <button data-nav-burger aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" class="nav-burger" style="display:none;align-items:center;justify-content:center;width:44px;height:44px;background:transparent;border:1px solid rgba(245,242,234,0.25);border-radius:999px;color:#F5F2EA;cursor:pointer;font-family:var(--mono);font-size:13px;">☰</button>
      </div>
    </nav>
  </header>

  <!-- MOBILE MENU -->
  <div id="mobile-menu" data-mobile-menu role="dialog" aria-modal="true" aria-label="Navigation" style="display:none;position:fixed;inset:0;z-index:80;background:var(--canvas);flex-direction:column;padding:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;">
      <span class="wordmark">JM<span>.</span></span>
      <button data-menu-close aria-label="Close menu" style="width:44px;height:44px;background:transparent;border:1px solid rgba(245,242,234,0.25);border-radius:999px;color:#F5F2EA;cursor:pointer;font-size:16px;">✕</button>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px;margin-top:64px;">
      <a href="#experiments" style="font-family:var(--display);font-weight:600;font-size:46px;letter-spacing:-0.02em;padding:8px 0;">Selected work</a>
      <a href="#thoughts" style="font-family:var(--display);font-weight:600;font-size:46px;letter-spacing:-0.02em;padding:8px 0;">Thoughts</a>
      <a href="#approach" style="font-family:var(--display);font-weight:600;font-size:46px;letter-spacing:-0.02em;padding:8px 0;">Start here</a>
      <a href="#about" style="font-family:var(--display);font-weight:600;font-size:46px;letter-spacing:-0.02em;padding:8px 0;">About</a>
    </div>
    <a href="#connect" style="margin-top:auto;display:block;text-align:center;background:#E8B44C;color:#0A0F1E;font-weight:600;font-size:17px;padding:16px 24px;border-radius:999px;">Let’s connect</a>
  </div>

  <main id="main-content">
  <!-- HERO -->
  <section class="hero-section" style="position:relative;padding:clamp(72px,12vh,140px) clamp(20px,5vw,72px) 96px;">
    <canvas data-particles aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;"></canvas>
    <div class="hero-glow" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 55% 45% at 72% 15%, rgba(59,91,255,0.3), rgba(59,91,255,0) 70%);"></div>
    <img class="hero-art" src="/assets/caricature-hero-white-teeth.png" alt="Illustrated caricature of Jeremy McKellar presenting with a tablet" style="position:absolute;right:clamp(24px,6vw,96px);bottom:0;width:clamp(260px,25vw,430px);filter:drop-shadow(0 30px 60px rgba(0,0,0,0.45));" />
    <div class="hero-content" style="position:relative;max-width:1400px;">
      <p class="eyebrow" style="margin:0 0 28px;color:var(--slate);">JEREMY McKELLAR — TECHNOLOGIST &amp; STORYTELLER · CHARLOTTE, NC</p>
      <h1 aria-label="Stay curious. Stay connected." style="margin:0;font-family:var(--display);font-weight:600;font-size:clamp(42px,10.5vw,160px);line-height:1.08;letter-spacing:-0.03em;">
        Stay <span style="display:inline-block;overflow:hidden;height:1.1em;line-height:1.1;vertical-align:-0.26em;"><span data-roll aria-hidden="true" style="display:flex;flex-direction:column;transform:translateY(0em);transition:transform 0.7s cubic-bezier(0.76,0,0.24,1);"><span style="display:block;height:1.1em;"><em style="color:#E8B44C;">curious</em>.</span><span style="display:block;height:1.1em;"><em style="color:#E8B44C;">building</em>.</span><span style="display:block;height:1.1em;"><em style="color:#E8B44C;">learning</em>.</span><span style="display:block;height:1.1em;"><em style="color:#E8B44C;">connected</em>.</span></span></span><br />
        Stay connected.
      </h1>
      <p class="hero-intro">I’m Jeremy, a technologist and storyteller exploring how AI and technology can make everyday work better. Find ideas you can use, try the apps I’m building, and get to know the person behind them.</p>
      <div class="hero-actions">
        <a data-magnetic href="#experiments" class="btn-gold lg">Explore my work &darr;</a>
        <a href="#about" class="text-link">Meet Jeremy &rarr;</a>
      </div>
      <p class="hero-context">A decade across solution design, customer success, and technology.</p>
    </div>
  </section>

  <!-- STATUS TICKER -->
  <div class="workbench-ticker">
    <span class="workbench-label">&#9656; ON MY WORKBENCH</span>
    <span class="workbench-text" data-typed-phrases={JSON.stringify(workbenchPhrases)}>
      {workbenchPhrases.map((phrase) => <span class="workbench-sizer" aria-hidden="true">{phrase}<span class="typed-cursor"></span></span>)}
      <span class="workbench-animation"><span data-typed>{workbenchPhrases[0]}</span><span class="typed-cursor" aria-hidden="true"></span></span>
    </span>
  </div>

  <section data-chapter="intro" id="approach" class="content-section approach-section">
    <div class="section-intro" data-reveal="0">
      <p class="eyebrow">01 / START HERE</p>
      <h2 class="section-title">Ideas to use.<br />Projects to explore.</h2>
      <p class="section-copy">Looking for practical ways to use AI, curious about what I’m building, or exploring a chance to work together? Find your starting point.</p>
    </div>
    <div class="approach-grid">
      <div class="approach-item" data-reveal="1">
        <span class="eyebrow">LEARN</span>
        <h3>Put AI to work.</h3>
        <p>Explore my writing on AI, modern work, and creativity—with ideas you can try in your own work.</p>
        <a class="text-link" href="#thoughts">Explore the articles &rarr;</a>
      </div>
      <div class="approach-item" data-reveal="2">
        <span class="eyebrow">BUILD</span>
        <h3>See what I’m building.</h3>
        <p>Explore apps and prototypes I’m developing in public. Try a working demo and follow what I’m learning as each project takes shape.</p>
        <a class="text-link" href="#experiments">View my projects &rarr;</a>
      </div>
      <div class="approach-item" data-reveal="3">
        <span class="eyebrow">CONNECT</span>
        <h3>Get to know me.</h3>
        <p>See how my experience in Microsoft 365, solution design, and customer success shapes my work—and where our interests might connect.</p>
        <a class="text-link" href="#about">Meet Jeremy &rarr;</a>
      </div>
    </div>
  </section>

  <!-- EXPERIMENTS -->
  <section data-chapter="work" id="experiments" style="padding:clamp(80px,12vw,140px) clamp(20px,5vw,72px) 0;max-width:1440px;margin:0 auto;">
    <div data-reveal="0" style="display:flex;flex-wrap:wrap;align-items:baseline;gap:16px 48px;margin-bottom:20px;">
      <span class="eyebrow">02 / SELECTED WORK</span>
    </div>
    <h2 data-reveal="1" style="margin:0 0 16px;font-family:var(--display);font-weight:600;font-size:clamp(40px,6vw,84px);letter-spacing:-0.025em;line-height:1.02;">Projects I’m building.</h2>
    <p data-reveal="2" style="margin:0 0 56px;font-size:19px;line-height:1.6;color:var(--slate);max-width:560px;">Explore my apps and works in progress. Try something useful, see how it was built, and follow the projects as they develop.</p>

    <div class="bento" style="display:grid;grid-template-columns:repeat(12,1fr);gap:20px;">
      <article data-tilt data-reveal="1" class="card" style="grid-column:span 7;display:flex;flex-direction:column;gap:16px;padding:clamp(28px,3.5vw,48px);min-height:320px;">
        <p style="margin:0;font-family:var(--mono);font-size:12px;letter-spacing:0.16em;color:#E8B44C;"><span style="color:#5BE87C;">●</span> LIVE / PRODUCTIVITY</p>
        <h3 style="margin:0;font-family:var(--display);font-weight:600;font-size:clamp(28px,3vw,42px);letter-spacing:-0.02em;line-height:1.05;">Universal Document Formatter</h3>
        <p style="margin:0;font-size:18px;line-height:1.65;color:var(--slate);max-width:520px;">Paste once. Format for LinkedIn, X, email, WhatsApp, or Instagram. Fine-tune the editable preview, then copy or download your text—no account needed.</p>
        <figure class="project-preview"><img src="/assets/formatter-preview-2026.jpg" alt="Universal Document Formatter’s refreshed interface showing five platform tabs, sample text, and an editable LinkedIn preview with copy and download controls" width="1348" height="926" style="aspect-ratio:1348/926;" loading="lazy" decoding="async" /><figcaption>Refreshed app · LinkedIn preview with sample content</figcaption></figure>
        <div style="display:flex;flex-wrap:wrap;gap:12px 28px;margin-top:auto;padding-top:16px;font-weight:600;font-size:16px;">
          <a href="https://document-formatter.netlify.app/" target="_blank" rel="noopener" style="color:#93A5FF;">Try it &nearr;</a>
          <a href="/thoughts/i-built-a-document-formatter-in-2-hours-to-stop-wasting-time/" style="color:#F5F2EA;">Read the story &rarr;</a>
        </div>
      </article>

      <article data-tilt data-reveal="2" class="card" style="grid-column:span 5;display:flex;flex-direction:column;gap:16px;padding:clamp(28px,3.5vw,48px);min-height:320px;">
        <p style="margin:0;font-family:var(--mono);font-size:12px;letter-spacing:0.16em;color:#E8B44C;"><span style="color:#5BE87C;">●</span> INTERACTIVE DEMO / CONNECTION</p>
        <h3 style="margin:0;font-family:var(--display);font-weight:600;font-size:clamp(28px,3vw,42px);letter-spacing:-0.02em;line-height:1.05;">PresentlyConnect</h3>
        <p style="margin:0;font-size:18px;line-height:1.65;color:var(--slate);">Explore a different way to keep in touch: share the life season you’re in instead of posting constant updates. Try the demo to see how it works.</p>
        <figure class="project-preview"><img src="/assets/presently-preview.png" alt="PresentlyConnect demo displaying life-season cards" width="1280" height="720" loading="lazy" decoding="async" /><figcaption>Interactive prototype · demo data</figcaption></figure>
        <div style="display:flex;flex-wrap:wrap;gap:12px 28px;margin-top:auto;padding-top:16px;font-weight:600;font-size:16px;">
          <a href="https://presentlyconnect.netlify.app/" target="_blank" rel="noopener" style="color:#93A5FF;">Try it &nearr;</a>
          <a href="/thoughts/presentlyconnect-life-seasons-social-app/" style="color:#F5F2EA;">Read the story &rarr;</a>
        </div>
      </article>

      <article data-reveal="3" style="grid-column:span 12;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px;background:transparent;border:1.5px dashed rgba(232,180,76,0.4);border-radius:24px;padding:clamp(28px,3.5vw,44px);">
        <div style="display:flex;flex-direction:column;gap:12px;max-width:640px;">
          <p style="margin:0;font-family:var(--mono);font-size:12px;letter-spacing:0.16em;color:var(--slate);">◌ IN PROGRESS</p>
          <h3 style="margin:0;font-family:var(--display);font-weight:600;font-size:clamp(24px,2.6vw,36px);letter-spacing:-0.02em;">Follow what’s next.</h3>
          <p style="margin:0;font-size:18px;line-height:1.65;color:var(--slate);">Want to see an idea become a working app? Follow me on LinkedIn for projects in progress, lessons from building, and things to try yourself.</p>
        </div>
        <div style="display:flex;align-items:center;gap:clamp(20px,3vw,44px);flex-shrink:0;">
          <img src="/assets/caricature-desk.png" alt="" aria-hidden="true" style="width:clamp(110px,13vw,170px);height:auto;" />
          <a data-magnetic href="https://www.linkedin.com/in/jeremy-mckellar/" target="_blank" rel="noopener" class="btn-outline" style="flex-shrink:0;">Follow on LinkedIn &nearr;</a>
        </div>
      </article>
    </div>
  </section>

  <!-- LATEST THOUGHTS -->
  <section data-chapter="writing" id="thoughts" style="padding:clamp(80px,12vw,140px) clamp(20px,5vw,72px) 0;max-width:1440px;margin:0 auto;">
    <div data-reveal="0" style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:20px;">
      <span class="eyebrow">03 / WRITING</span>
      <a href="/thoughts/" style="font-weight:600;font-size:16px;color:#93A5FF;">Browse all articles &rarr;</a>
    </div>
    <h2 data-reveal="1" style="margin:0 0 20px;font-family:var(--display);font-weight:600;font-size:clamp(40px,6vw,84px);letter-spacing:-0.025em;line-height:1.02;">Ideas for your everyday work.</h2>
    <p class="section-copy" data-reveal="2" style="margin-bottom:40px;">Start with a fresh approach to AI, decision-making, or leadership. These articles offer a few ways to think through the challenges in front of you.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;">
      {latest.map((post, i) => (
        <a data-tilt data-reveal={i + 1} href={`/thoughts/${post.slug}/`} class="card" style="display:flex;flex-direction:column;gap:14px;padding:32px;color:#F5F2EA;">
          <span style="font-family:var(--mono);font-size:12px;letter-spacing:0.14em;color:#E8B44C;">{post.date}</span>
          <span style="font-family:var(--display);font-weight:600;font-size:26px;letter-spacing:-0.015em;line-height:1.12;">{post.title}</span>
          <span style="font-size:16px;line-height:1.6;color:#8A93A8;">{post.homeExcerpt ?? post.excerpt}</span>
          <span style="margin-top:auto;padding-top:10px;font-weight:600;font-size:15px;color:#93A5FF;">Read &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <!-- WRITING + CONVERSATIONS -->
  <section data-chapter="conversation" id="podcast" class="discovery-section">
    <article class="discovery-panel discovery-writing" data-reveal="1">
      <div class="discovery-copy">
        <p class="eyebrow">KEEP EXPLORING</p>
        <h3>Find an idea to try.</h3>
        <p>Explore practical ways to use AI, make a difficult decision, or bring a creative idea to life.</p>
        <a data-magnetic href="/thoughts/" class="btn-cobalt">Browse the articles &rarr;</a>
      </div>
      <figure class="discovery-scene"><img src="/assets/caricature-writing-scene.webp" alt="Jeremy sitting in a lounge chair, writing in a notebook" width="960" height="640" loading="lazy" decoding="async" /></figure>
    </article>
    <article class="discovery-panel discovery-conversation" data-reveal="2">
      <div class="discovery-copy">
        <p class="eyebrow">04 / CONVERSATIONS</p>
        <h3>Tech Innovation<br />Made Human.</h3>
        <p>Join me and my co-hosts to explore what’s changing in AI and technology—and what it means for your work and life.</p>
        <a data-magnetic href="https://www.youtube.com/playlist?list=PL0REkMdZtFzPV9QSVm3D4iIuTeh99Mhwa" target="_blank" rel="noopener" class="btn-gold">Watch the conversations &nearr;</a>
        <small>Part of the Tech Simplified Network.</small>
      </div>
      <figure class="discovery-scene"><img src="/assets/caricature-recording-scene.webp" alt="Jeremy wearing headphones and recording at a podcast microphone" width="960" height="640" loading="lazy" decoding="async" /></figure>
    </article>
  </section>

  <section class="content-section creative-note" aria-labelledby="creative-title">
    <div data-reveal="0">
      <p class="eyebrow">ALSO BEHIND THE CAMERA</p>
      <h2 id="creative-title">Photography &amp; visual stories.</h2>
    </div>
    <div data-reveal="1">
      <p>See the people, moments, and stories I capture through Motion Visual Media. Explore my photography and visual work for a different side of what I create.</p>
      <a class="text-link" href="https://motionvisualmedia.com/" target="_blank" rel="noopener">View my visual work &nearr;</a>
    </div>
  </section>

  <!-- ABOUT -->
  <section data-chapter="about" id="about" style="padding:clamp(80px,12vw,140px) clamp(20px,5vw,72px) 0;max-width:1440px;margin:0 auto;">
    <div class="about-grid" style="display:grid;grid-template-columns:1.15fr 0.85fr;gap:clamp(32px,5vw,80px);align-items:start;">
      <div style="display:flex;flex-direction:column;gap:24px;">
        <span data-reveal="0" class="eyebrow">05 / ABOUT</span>
        <h2 data-reveal="1" style="margin:0;font-family:var(--display);font-weight:600;font-size:clamp(40px,5.5vw,76px);letter-spacing:-0.025em;line-height:1.04;">Hi, I’m Jeremy.</h2>
        <div data-reveal="2" style="display:flex;flex-direction:column;gap:18px;font-size:19px;line-height:1.7;color:var(--prose);max-width:640px;">
          <p style="margin:0;">I&rsquo;m a technologist, connector, and creative who&rsquo;s spent over a decade helping people and organizations make sense of technology &mdash; from Microsoft 365 to applied AI. I&rsquo;ve worked across architecture, customer success, and solution design &mdash; turning complexity into clarity and building systems that actually work for people.</p>
          <p style="margin:0;">I’m most interested in what happens after a new tool is introduced: how people understand it, use it, and find value in it. That’s what I explore in my writing, prototypes, and conversations about AI and modern work.</p>
          <p style="margin:0;">Based in Charlotte, NC, I&rsquo;m driven by creativity and connection &mdash; whether I&rsquo;m behind a camera, sketching a new idea, or recording for my podcast. Lifelong learner, occasional philosopher over a glass of wine.</p>
        </div>
        <ul data-reveal="3" style="list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column;gap:12px;font-family:var(--mono);font-size:15px;color:#F5F2EA;">
          <li style="display:flex;gap:12px;align-items:baseline;"><span style="color:#E8B44C;">✦</span> AI adoption &amp; enablement</li>
          <li style="display:flex;gap:12px;align-items:baseline;"><span style="color:#E8B44C;">✦</span> Modern work &amp; productivity</li>
          <li style="display:flex;gap:12px;align-items:baseline;"><span style="color:#E8B44C;">✦</span> Creative builds &amp; prototypes</li>
          <li style="display:flex;gap:12px;align-items:baseline;"><span style="color:#E8B44C;">✦</span> Storytelling &amp; speaking</li>
        </ul>
        <div data-reveal="4" style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:12px;">
          <a data-magnetic href="#connect" class="btn-gold lg">Let’s connect</a>
          <a data-magnetic href="https://www.linkedin.com/in/jeremy-mckellar/" target="_blank" rel="noopener" class="btn-outline" style="padding:15px 30px;">Connect on LinkedIn &nearr;</a>
          <a href="https://ingoodconnects.com" target="_blank" rel="noopener" style="font-weight:600;font-size:16px;color:#93A5FF;">In Good Company &nearr;</a>
        </div>
      </div>
      <div data-reveal="2" style="position:relative;aspect-ratio:4/5;border-radius:28px;border:1px solid rgba(245,242,234,0.12);overflow:hidden;background:var(--card);">
        <img src="/assets/jeremy-headshot.jpg" alt="Jeremy McKellar" style="width:100%;height:100%;object-fit:cover;display:block;" />
      </div>
    </div>
  </section>

  <section data-chapter="connect" id="connect" class="content-section connect-section">
    <div data-reveal="0">
      <p class="eyebrow">06 / LET’S CONNECT</p>
      <h2 class="section-title">Have a role or<br />an idea in mind?</h2>
      <p class="section-copy">If my experience fits your team, you’re planning a talk, or you’d like to build something together, tell me what you have in mind.</p>
      <div class="contact-options">
        <a class="btn-gold lg" href="mailto:info@jeremymckellar.com?subject=Career%20opportunity">Talk about a role &nearr;</a>
        <a class="btn-outline" href="mailto:info@jeremymckellar.com?subject=Speaking%20or%20collaboration">Plan a talk or collaboration &nearr;</a>
      </div>
      <a class="text-link email-link" href="mailto:info@jeremymckellar.com">info@jeremymckellar.com</a>
    </div>
    <div data-reveal="1"><FollowUpdates /></div>
  </section>
  </main>

  <!-- FOOTER -->
  <footer style="margin-top:clamp(96px,14vw,180px);border-top:1px solid var(--hairline);padding:clamp(72px,10vw,140px) clamp(20px,5vw,72px) 44px;">
    <p data-reveal="0" style="margin:0;font-family:var(--display);font-weight:600;font-size:clamp(44px,8.5vw,132px);letter-spacing:-0.03em;line-height:1.04;">Stay <em style="color:#E8B44C;">curious</em>.<br />Stay connected.</p>
    <div data-reveal="1" style="display:flex;flex-wrap:wrap;gap:14px 40px;margin-top:48px;font-weight:600;font-size:17px;">
      <a href="mailto:info@jeremymckellar.com" style="color:#93A5FF;">info@jeremymckellar.com</a>
      <a href="https://www.linkedin.com/in/jeremy-mckellar/" target="_blank" rel="noopener">LinkedIn &nearr;</a>
      <a href="https://ingoodconnects.com" target="_blank" rel="noopener">In Good Company &nearr;</a>
    </div>
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin-top:64px;font-family:var(--mono);font-size:13px;color:var(--slate);">
      <span>&copy; 2026 Jeremy McKellar · Charlotte, NC</span>
      <a href="#top" style="color:var(--slate);">Back to top &uarr;</a>
    </div>
  </footer>
</div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import experience from '../data/experience.json';
---
<BaseLayout title="Jeremy McKellar — My Experience" description="The experiences behind Jeremy McKellar’s perspective on enterprise architecture, AI, modern work, and the people using technology.">
  <header class="site-nav"><nav aria-label="Main">
    <a href="/" class="wordmark" aria-label="Jeremy McKellar — home">JM<span>.</span></a>
    <div class="experience-nav"><a href="/#experiments">Projects</a><a href="/#about">About</a><a class="btn-gold" href="mailto:info@jeremymckellar.com">Let’s connect</a></div>
  </nav></header>
  <main id="main-content" class="experience-page">
    <section class="journey-opening">
      <p class="eyebrow">A LITTLE MORE OF MY BACKGROUND</p>
      <h1>The work behind<br /><em>the perspective.</em></h1>
      <p>My path at Microsoft has taken me from cloud migrations and technical problem-solving to enterprise architecture and applied AI. Each chapter shapes what I build, share, and bring to a conversation today.</p>
      <a class="text-link" href="/">← Back to the whole picture</a>
    </section>
    <section id="career" class="journey-section" aria-labelledby="journey-heading">
      <div class="journey-header">
        <div><p class="eyebrow">MICROSOFT / 2018 — PRESENT</p><h2 id="journey-heading">A few chapters along the way.</h2></div>
        <p class="journey-hint" id="journey-hint">Swipe or scroll sideways to explore.</p>
      </div>
      <div class="journey-controls" hidden>
        <div class="journey-years" role="group" aria-label="Choose a career chapter">{experience.timeline.map((chapter, i) => <button type="button" data-chapter-index={i} aria-controls={`chapter-${i}`} aria-current={i === 0 ? 'step' : undefined}>{chapter.year}</button>)}</div>
        <div class="journey-arrows"><button type="button" data-previous aria-label="Previous chapter" aria-controls="journey-track">←</button><button type="button" data-next aria-label="Next chapter" aria-controls="journey-track">→</button></div>
      </div>
      <div class="journey-track" id="journey-track" tabindex="0" role="region" aria-label="Career timeline" aria-describedby="journey-hint">
        {experience.timeline.map((chapter, i) => (
          <article class="journey-card" id={`chapter-${i}`} aria-labelledby={`chapter-title-${i}`}>
            <div class="journey-card-top"><span class="eyebrow">CHAPTER 0{i + 1}</span><span class="journey-period">{chapter.period}</span></div>
            <h3 id={`chapter-title-${i}`}>{chapter.title}</h3>
            <p class="journey-role">{chapter.role}</p>
            <p class="journey-summary">{chapter.summary}</p>
            <div class="journey-card-body"><div><h4>The work</h4><ul>{chapter.work.map(item => <li>{item}</li>)}</ul></div><aside><h4>What I take forward</h4><p>{chapter.perspective}</p></aside></div>
          </article>
        ))}
      </div>
      <p class="journey-status" aria-live="polite" aria-atomic="true" hidden></p>
    </section>
    <section class="journey-beyond">
      <div><p class="eyebrow">WHAT CONNECTS IT ALL</p><h2>Technology.<br />People. Possibility.</h2></div>
      <div><p>Enterprise architecture is one part of my perspective. Building independent apps, writing, photography, and conversations with other people give me different ways to explore the same question: how can we make something that matters?</p><p>I’m especially interested in practical AI, modern work, and helping people make sense of change. Those are ideas I enjoy exploring with teams, communities, and audiences.</p><a href="/#experiments" class="text-link">See what I’m building →</a></div>
    </section>
    <details class="background-details">
      <summary>Technical background, education &amp; credentials</summary>
      <div class="expertise-grid">{experience.expertise.map(area => <div><h3>{area.title}</h3><p>{area.skills}</p></div>)}</div>
      <p><strong>University of North Carolina at Chapel Hill</strong><br />B.S., Information Science</p>
      <ul class="credential-list">{experience.credentials.map(credential => <li>{credential}</li>)}</ul>
    </details>
    <section class="journey-contact"><p class="eyebrow">KEEP THE CONVERSATION GOING</p><h2>What are you exploring?</h2><p>Whether it’s a speaking engagement, a project, a role, or simply an idea worth talking through, I’d love to hear about it.</p><div class="contact-options"><a class="btn-gold lg" href="mailto:info@jeremymckellar.com">Let’s connect ↗</a><a class="btn-outline" href="mailto:info@jeremymckellar.com?subject=Speaking%20or%20collaboration">Speaking &amp; collaboration ↗</a></div></section>
  </main>
  <footer class="site-footer"><span>Jeremy McKellar · Charlotte, NC</span><a href="/">Stay curious. Stay connected. ↗</a></footer>
  <script src="/scripts/experience.js" defer></script>
</BaseLayout>

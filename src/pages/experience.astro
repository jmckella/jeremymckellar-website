---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerProof from '../components/CareerProof.astro';
import experience from '../data/experience.json';
const filters = [ ['all', 'All experience'], ['ai', 'AI & Copilot'], ['architecture', 'Architecture'], ['security', 'Security & governance'], ['delivery', 'Customer delivery'] ];
---
<BaseLayout title="Jeremy McKellar — Experience & Resume" description="Explore Jeremy McKellar’s Microsoft career across enterprise architecture, migrations, AI agents, Copilot, identity, security, and customer delivery.">
  <header class="site-nav"><nav aria-label="Main">
    <a href="/" class="wordmark" aria-label="Jeremy McKellar — home">JM<span>.</span></a>
    <div class="experience-nav"><a href="/#experiments">Projects</a><a href="/#about">About</a><a class="btn-gold" href="mailto:info@jeremymckellar.com?subject=Career%20opportunity">Let’s connect</a></div>
  </nav></header>
  <main id="main-content" class="experience-page">
    <section class="experience-opening">
      <div>
        <p class="eyebrow">EXPERIENCE / JEREMY McKELLAR</p>
        <h1>Architecture.<br />Delivery.<br /><em>Real-world impact.</em></h1>
        <p class="section-copy">I’m a forward-deployed architect helping organizations move from technical complexity to secure, working solutions. My foundation is 8+ years at Microsoft across migrations, technical escalation, and Modern Work architecture, with a growing focus on applied AI.</p>
        <p class="career-location">Charlotte, NC · Interested in remote opportunities</p>
        <div class="contact-options">
          <a href="#career" class="btn-gold lg">Explore my experience ↓</a>
          <button id="print-resume" class="btn-outline" hidden>Print / save PDF</button>
        </div>
        <p class="print-contact">jeremymckellar.com · info@jeremymckellar.com</p>
      </div>
      <figure class="experience-portrait"><img src="/assets/jeremy-headshot.jpg" alt="Jeremy McKellar" width="600" height="750" /><figcaption>Modern Work Architect · Microsoft FastTrack</figcaption></figure>
    </section>
    <CareerProof />
    <section id="career" class="career-section">
      <p class="eyebrow">MICROSOFT / 2018 — PRESENT</p>
      <h2 class="section-title">Explore the work.</h2>
      <p class="section-copy">From migration engineering to customer-facing architecture. Expand a role to see the work behind it.</p>
      <div class="career-filters" role="group" aria-label="Filter career accomplishments" hidden>
        {filters.map(([value, label]) => <button type="button" data-focus={value} aria-pressed={value === 'all'}>{label}</button>)}
      </div>
      <p class="career-filter-status" aria-live="polite" id="filter-status"></p>
      <div class="career-timeline">
        {experience.roles.map((role, index) => (
          <details class="career-role" open={index === 0} data-career-role>
            <summary><span class="role-period">{role.period}</span><span class="role-heading"><strong>{role.title}</strong><span>{role.context}</span></span><span class="role-toggle" aria-hidden="true">+</span></summary>
            <div class="role-content">
              <p class="role-summary">{role.summary}</p>
              <ul>{role.items.map(item => <li data-accomplishment data-category={item.focus}>{item.text}</li>)}</ul>
            </div>
          </details>
        ))}
      </div>
    </section>
    <section class="career-section" id="expertise">
      <p class="eyebrow">TECHNICAL FOUNDATION</p><h2 class="section-title">What I bring.</h2>
      <div class="expertise-grid">{experience.expertise.map(area => <div><h3>{area.title}</h3><p>{area.skills}</p></div>)}</div>
    </section>
    <section class="career-section career-next">
      <div><p class="eyebrow">WHERE I’M GOING DEEPER</p><h2 class="section-title">Applied AI,<br />built with intent.</h2></div>
      <div><p class="section-copy">I’m building on my customer-facing architecture experience to go deeper into AI systems and product delivery. My learning focus includes Python, API integrations, retrieval, agent workflows, and evaluation.</p><p class="section-copy">The independent apps on my site show my product work today. As new AI projects take shape, I’ll share their implementation decisions, limitations, and results.</p><a class="text-link" href="/#experiments">Explore my independent projects →</a></div>
    </section>
    <section class="career-section credentials-section">
      <p class="eyebrow">EDUCATION &amp; CREDENTIALS</p><h2 class="section-title">A foundation to build on.</h2>
      <p class="section-copy"><strong>University of North Carolina at Chapel Hill</strong><br />B.S., Information Science</p>
      <details class="credential-details" open><summary>Certifications &amp; credentials</summary><ul>{experience.credentials.map(credential => <li>{credential}</li>)}</ul></details>
    </section>
    <section class="career-section career-contact">
      <p class="eyebrow">LET’S CONNECT</p><h2 class="section-title">Have a role in mind?</h2>
      <p class="section-copy">I’m interested in remote AI Solutions Architect, Product/AI Architect, and forward-deployed roles that connect customer problems with technical delivery.</p>
      <div class="contact-options"><a class="btn-gold lg" href="mailto:info@jeremymckellar.com?subject=Career%20opportunity">Talk about a role ↗</a><a class="btn-outline" href="https://www.linkedin.com/in/jeremy-mckellar/" target="_blank" rel="noopener">Connect on LinkedIn ↗</a></div>
    </section>
  </main>
  <footer class="site-footer"><span>Jeremy McKellar · Experience updated {experience.updated}</span><a href="/">Stay curious. Stay connected. ↗</a></footer>
  <script src="/scripts/experience.js" defer></script>
</BaseLayout>
